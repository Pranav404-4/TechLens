{
  "manifest_version": 3,
  "name": "TechLens \u2014 Technology Detector",
  "version": "1.0.0",
  "description": "Passively identify website technologies from page evidence and response headers.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "techlens-detector@example.local",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "TechLens Technology Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
     "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
